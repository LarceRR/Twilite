{
  "expo": {
    "name": "Twilite",
    "slug": "twilite",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "twilite",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "src/assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.twilite.app"
    },
    "android": {
      "package": "com.twilite.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Twilite нужен доступ к камере, чтобы сканировать QR-код входа и снимать аватар",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Twilite нужен доступ к фото, чтобы обновить аватар профиля",
          "cameraPermission": "Twilite нужен доступ к камере, чтобы сделать фото для аватара"
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-asset",
      "@sentry/react-native",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "twilite",
          "organization": "larace"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "src/app/routes"
      },
      "mode": "development",
      "apiBaseUrl": {},
      "websocketUrl": {},
      "eas": {
        "projectId": "e767297b-88e6-4ccf-895d-0fd0b6613273"
      }
    },
    "owner": "denzare"
  }
}
